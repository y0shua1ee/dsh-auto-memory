{
  "name": "dsh-auto-memory",
  "version": "0.2.0",
  "description": "Persistent project memory and Claude Code-compatible rules for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "memory",
    "auto-memory",
    "rules",
    "claude-code",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --import ./test/register.mjs --test test/*.test.mjs",
    "extract-runtime": "node scripts/extract-runtime.mjs"
  },
  "author": "Ares Lee",
  "homepage": "https://github.com/y0shua1ee/dsh-auto-memory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y0shua1ee/dsh-auto-memory.git"
  },
  "bugs": {
    "url": "https://github.com/y0shua1ee/dsh-auto-memory/issues"
  },
  "icon": "assets/icon.svg",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
