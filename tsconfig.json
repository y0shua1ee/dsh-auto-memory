{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-llm": ["types/dsh-llm.d.ts"],
      "@deepseek-ai/dsh-tools": ["types/dsh-tools.d.ts"],
      "@deepseek-ai/dsh-home-paths": ["types/dsh-home-paths.d.ts"],
      "@deepseek-ai/schemastery": ["types/schemastery.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "test"]
}
